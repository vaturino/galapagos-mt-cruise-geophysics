# Large binary data — see DATA_MANIFEST.md for sources; scripts/ regenerates
# GeoMapApp-ready and viewer-ready copies from those sources.
*.grd
*.tif
*.tiff
*.asc
*.nc
*.gz
*.tar
*.zip

# Cruise-internal, non-public dataset (see root README.md's Data section)
GeoMapApp_ready/

# Vendored CesiumJS build — fetch from the `cesium` npm package instead
Viewer3D/cesium/

# Generated viewer meshes/manifest — regenerate with scripts/build_cesium_mesh.py
# and scripts/build_geophysics_drape.py (see Viewer3D/README.md)
Viewer3D/data/

# Python virtual environment — recreate per-machine with scripts/setup_env.sh
scripts/venv/
scripts/__pycache__/
__pycache__/
*.pyc

# macOS
.DS_Store
._*

# Editor/OS cruft
*.swp
.Trash*

# macOS external-volume metadata folders
.fseventsd/
.Trashes/
.Spotlight-V100/
.TemporaryItems/

# Script run logs (not documentation)
*.log

# Windows/exFAT external-drive metadata folders
$RECYCLE.BIN/
System Volume Information/

# Old Viewer3D UI, superseded by Viewer3D_NewLayout/ -- kept on disk (and
# Viewer3D_NewLayout/cesium|data still symlink to Viewer3D/'s own copies of
# those), just no longer tracked on GitHub. Viewer3D/README.md stays tracked
# -- it's the fuller dataset/setup reference, not duplicated elsewhere.
Viewer3D/app.js
Viewer3D/index.html
Viewer3D/style.css
